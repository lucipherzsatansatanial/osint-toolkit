# บังคับให้ทุก API call ส่ง header X-API-Key (แนะนำให้ตั้งเสมอเมื่อ deploy)
OSINT_API_KEY=change-me
# ไม่บังคับ — เปิดโมดูลเพิ่มเติม
HIBP_API_KEY=
IPINFO_TOKEN=
# DNS resolvers (comma-separated); ว่าง = ใช้ของระบบ
OSINT_NAMESERVERS=1.1.1.1,8.8.8.8
OSINT_RETENTION_DAYS=90
OSINT_RATE_LIMIT=30
# SOC dashboard: off = real ingested telemetry only
SOC_SIMULATION=on
# Hosts allowed to call AI model APIs (comma-separated) and server host-name prefixes
SOC_AI_APPROVED_HOSTS=
SOC_SERVER_PREFIXES=SRV
# SOC: retention for persisted real alerts/incidents, and start CTI + correlation at boot
SOC_RETENTION_DAYS=90
SOC_AUTOSTART=on
